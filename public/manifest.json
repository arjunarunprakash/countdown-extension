{
  "manifest_version": 3,
  "name": "Countdown",
  "version": "1.0.0",
  "description": "See how long you really have until every deadline and exam. Live countdowns in Chrome's side panel. Your data stays on your device.",
  "minimum_chrome_version": "123",
  "permissions": [
    "sidePanel",
    "storage",
    "alarms",
    "offscreen"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "action": {
    "default_title": "Open Countdown",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
